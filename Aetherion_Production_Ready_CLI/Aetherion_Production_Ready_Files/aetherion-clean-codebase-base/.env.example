# =============================================================================
# Aetherion Platform Configuration Template
# All secrets must be generated independently with high entropy.
# Never commit populated .env files to source control.
# =============================================================================

# Runtime Environment Mode (local-development | CI-test | staging | production)
ENVIRONMENT=local-development

# Server Network Configuration (127.0.0.1 for local/staging loopback; 0.0.0.0 for container ingress)
HOST=127.0.0.1
PORT=5000
SERVER_URL=http://localhost:5000

# Security Keys (Must be independent, random 32+ character strings)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET=

# Database Connection Strategy:
# 1. Windows Local Development: postgresql://aetherion_staging_user:password@127.0.0.1:5432/aetherion_staging
# 2. Local Docker Compose UAT:  postgresql://aetherion_user:password@postgres:5432/aetherion (internal bridge)
# 3. Hosted Cloud Deployment:    postgresql://app_user:password@cloud-host:5432/dbname?sslmode=require
DATABASE_URL=
CLOUD_DATABASE_URL=
# Dedicated test/audit script database connection (strictly required for test/audit scripts; no fallback)
AETHERION_TEST_DATABASE_URL=
# Independently approved non-production test target allowlists (comma-separated; required for test execution)
AETHERION_TEST_ALLOWED_HOSTS=
AETHERION_TEST_ALLOWED_DBS=

# Redis Connection (Mandatory for multi-worker and production task coordination)
# Example: redis://localhost:6379/0
REDIS_URL=

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sandbox & Container Isolation (Set to 1 when running inside container runner)
RUNNER_CONTAINER=0

# AI Provider API Keys (Configure as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
