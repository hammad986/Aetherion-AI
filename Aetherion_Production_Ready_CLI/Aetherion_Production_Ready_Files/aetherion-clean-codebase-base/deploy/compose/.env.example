# =============================================================================
# AETHERION PRODUCTION DEPLOYMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure all secrets before launching containers.
# NEVER commit .env to version control or use placeholder secrets in production.
# =============================================================================

# --- Environment Identity ---
ENVIRONMENT=production
AETHERION_ENV=production
RUNNER_CONTAINER=1
REQUIRE_SANDBOX=false

# --- Networking & Ports ---
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL Authoritative Source of Truth) ---
POSTGRES_DB=aetherion
POSTGRES_USER=aetherion_user
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgresql://aetherion_user:REPLACE_WITH_SECURE_RANDOM_POSTGRES_PASSWORD@postgres:5432/aetherion
AETHERION_TEST_DATABASE_URL=postgresql://aetherion_user:REPLACE_WITH_SECURE_RANDOM_POSTGRES_PASSWORD@postgres:5432/aetherion
AETHERION_TEST_ALLOWED_HOSTS=127.0.0.1,localhost,postgres
AETHERION_TEST_ALLOWED_DBS=aetherion,aetherion_test
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Transient Coordination (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- Application Security Secrets ---
# MUST be at least 32 characters, cryptographically random, and INDEPENDENT.
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_INDEPENDENT_SECURE_64_CHAR_HEX_SECRET_KEY
JWT_SECRET=REPLACE_WITH_INDEPENDENT_SECURE_64_CHAR_HEX_JWT_SECRET

# --- Worker Fleet Configuration ---
# Worker A
WORKER_A_ID=worker-a
WORKER_A_MAX_CONCURRENCY=4
WORKER_A_CAPABILITIES=DEFAULT,CPU

# Worker B
WORKER_B_ID=worker-b
WORKER_B_MAX_CONCURRENCY=4
WORKER_B_CAPABILITIES=DEFAULT,CPU

# --- AI Providers (Configure at least one for execution) ---
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
