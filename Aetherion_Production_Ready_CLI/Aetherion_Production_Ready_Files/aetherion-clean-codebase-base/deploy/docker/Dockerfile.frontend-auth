# =============================================================================
# Stage 1: Build Frontend Assets
# =============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend-auth/package.json frontend-auth/package-lock.json ./
RUN npm ci

COPY frontend-auth/ ./
RUN npm run build

# =============================================================================
# Stage 2: Hardened Unprivileged Non-Root Nginx Runtime
# =============================================================================
FROM nginxinc/nginx-unprivileged:alpine AS runner

USER root

# Remove default nginx configs and setup ownership
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/* && \
    chown -R 101:101 /usr/share/nginx/html

# Copy custom reverse-proxy config and compiled artifacts
COPY --chown=101:101 deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 --from=builder /app/dist /usr/share/nginx/html

USER 101

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
